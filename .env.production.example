# Plantilla del despliegue (ODON-238). Copia a .env en la raíz, fuera de Git, y
# reemplaza los valores. Usa una contraseña sin caracteres reservados de URL.
POSTGRES_USER=odontonet
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD
POSTGRES_DB=odontonet
POSTGRES_PORT=5432

# Nombre del servidor en la red de la clínica.
ODONTONET_DOMAIN=odontonet.internal
ODONTONET_HTTP_PORT=80
ODONTONET_HTTPS_PORT=443

# Carpeta del equipo con las imágenes clínicas. Igual a IMAGE_STORAGE_DIR de backend/.env.
ODONTONET_IMAGE_DIR=C:\OdontoNet\imagenes
