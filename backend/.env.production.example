# Plantilla de producción (ODON-234). Copia a backend/.env, fuera de Git, y reemplaza
# los valores. La aplicación no arranca si queda alguno de ejemplo.
APP_ENV=production

# PostgreSQL, visto desde este equipo: lo usan las herramientas de respaldo. Dentro
# del contenedor, Docker Compose lo sustituye. Mismos datos que en el .env de la raíz.
DATABASE_URL=postgresql+psycopg2://odontonet:REEMPLAZAR_CON_PASSWORD@127.0.0.1:5432/odontonet

# JWT. Genera la clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_AL_MENOS_32_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_EXPIRE_HOURS=12
REMEMBER_ME_EXPIRE_DAYS=7

# Frontend y API se sirven desde el mismo origen: CORS vacío.
CORS_ORIGINS=
# Nombre del servidor en la red de la clínica.
ALLOWED_HOSTS=odontonet.internal
FRONTEND_URL=https://odontonet.internal
# La API corre detrás de un único proxy de confianza.
TRUST_PROXY_HEADERS=true

# Correo opcional. Sin SMTP_HOST no se envían correos: administración cambia
# la contraseña desde Usuarios.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OdontoNet <no-reply@odontonet.local>
SMTP_STARTTLS=true

# Carpeta de las imágenes clínicas en este equipo, la misma de ODONTONET_IMAGE_DIR
# en el .env de la raíz. Se respalda junto con la base.
IMAGE_STORAGE_DIR=C:\OdontoNet\imagenes
IMAGE_MAX_MB=10
