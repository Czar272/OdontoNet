
# PostgreSQL
DATABASE_URL=postgresql+psycopg2://odontonet:REEMPLAZAR_CON_PASSWORD_LOCAL@127.0.0.1:5432/odontonet

# JWT
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Duración de la sesión con "Recuérdame" (días)
REMEMBER_ME_EXPIRE_DAYS=7

# CORS: orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173

# Recuperación de contraseña (ODON-54)
# URL del frontend para armar el enlace del correo
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=3

# Correo saliente. Con SMTP_HOST vacío (desarrollo) el correo se escribe en
# el log de la API en lugar de enviarse. En producción es obligatorio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OdontoNet <no-reply@odontonet.local>
SMTP_STARTTLS=true
