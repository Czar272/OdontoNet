# Configuración de respaldos de OdontoNet (ODON-226).
# Copia este archivo FUERA del repositorio, p. ej. a %USERPROFILE%\.odontonet\backup.env,
# y pasa su ruta con -Config. Nunca lo subas a Git: contiene la clave de la nube y la ruta
# a la contraseña de cifrado. Restringe sus permisos a la cuenta que corre los respaldos:
#   icacls backup.env /inheritance:r /grant:r "%USERNAME%:F"

# Repositorio restic local: un disco externo o un NAS, no el mismo disco del servidor.
ODONTONET_BACKUP_LOCAL_REPO=E:\respaldos\odontonet

# Archivo con la contraseña de cifrado de restic (una línea). Guárdalo también en un
# gestor de contraseñas y en papel sellado (dos custodios): sin ella no se puede restaurar.
ODONTONET_BACKUP_PASSWORD_FILE=C:\Users\USUARIO\.odontonet\restic-password.txt

# Repositorio en la nube (opcional; vacío = solo local). Backblaze B2 con su API compatible con S3:
#   s3:https://s3.<región>.backblazeb2.com/<bucket>/odontonet
ODONTONET_BACKUP_CLOUD_REPO=
# Clave de aplicación de B2 SIN permiso de borrado (deleteFiles), para que el servidor solo
# agregue respaldos. Pendiente de ensayo: con la API S3, un borrado puede «ocultar» archivos
# sin borrarlos (ver docs/BACKUPS.md, «Nube: qué está probado y qué no»).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Opcional: ruta a restic.exe si no está en el PATH.
RESTIC_EXE=
