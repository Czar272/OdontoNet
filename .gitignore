
# ==========================================
# OdontoNet - Git Ignore
# ==========================================

# Variables de entorno y secretos
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Entornos virtuales de Python
venv/
.venv/
odonto_venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Node.js / React / Vite
node_modules/
dist/
dist-ssr/
coverage/
.vite/
*.local

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editores
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Archivos locales
commands.md
api_tests.txt
*.sqlite
*.sqlite3
*.db

# Datos privados y archivos clínicos
uploads/
private/
backups/
storage/
*.bak
*.dump

# Datasets y pesos de IA
ai-service/datasets/
ai-service/weights/
ai-service/checkpoints/
*.pt
*.pth
*.ckpt

# Archivos temporales
tmp/
temp/
.cache/

# Herramientas locales del desarrollador
CLAUDE.md
CLAUDE.local.md
.claude/
.mcp.json
